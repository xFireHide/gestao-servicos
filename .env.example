# API
NODE_ENV=development
PORT=3001

# PostgreSQL (docker-compose) — host port 5433 para evitar conflito com outros Postgres locais
DATABASE_URL=postgresql://clinica:clinica@localhost:5433/clinica?schema=public

# Redis (BullMQ + cache) — host port 6380
REDIS_URL=redis://localhost:6380

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Criptografia a nível de campo (PII) — 32 bytes base64
FIELD_ENCRYPTION_KEY=Z2VuZXJhdGUtYS1yZWFsLTMyLWJ5dGUta2V5LWhlcmU=

# S3 / MinIO (anexos EHR — Fase 2)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clinica-ehr

# Frontends
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# E-mail (SMTP)
# DEV: MailHog (captura local, sem credenciais) — host.docker / localhost:1025
# PROD: aponte para um provedor real (SES, SendGrid, Resend, etc.):
#   SMTP_HOST=smtp.seu-provedor.com  SMTP_PORT=587  SMTP_SECURE=false (587/STARTTLS) ou true (465)
#   SMTP_USER=...  SMTP_PASS=...  (use uma senha/app key real — NUNCA commite)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@clinica.local
