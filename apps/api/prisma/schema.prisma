// Schema do monólito modular. A invariante anti-double-booking é aplicada por uma
// exclusion constraint adicionada via migration SQL custom (ver ADR 0002).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  RECEPTIONIST
  DOCTOR
  ADMIN
}

/// Vertical de negócio da empresa-cliente (tenant) do SaaS.
enum BusinessType {
  CLINIC
  SALON
  GYM
  WORKSHOP
  CONSULTING
  GENERIC
}

/// Plano de assinatura do SaaS.
enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

/// Situação da assinatura de uma empresa.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Empresa-cliente (tenant). Todo dado de domínio pertence a exatamente uma Organization;
/// o isolamento é forçado na camada de acesso (ver tenant middleware do Prisma).
model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  slug               String             @unique
  businessType       BusinessType       @default(GENERIC)
  plan               SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users          User[]
  doctors        Doctor[]
  patients       Patient[]
  services       Service[]
  availabilities Availability[]
  appointments   Appointment[]

  @@map("organizations")
}

/// Item do catálogo de serviços de uma empresa (preço + duração). Generaliza o
/// conceito de "consulta" para qualquer negócio: corte, revisão, aula, sessão...
model Service {
  id              String       @id @default(uuid()) @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String       @db.Uuid
  name            String
  description     String?
  priceCents      Int          @default(0)
  durationMinutes Int
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  appointments Appointment[]

  @@index([organizationId])
  @@map("services")
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Funil de cliente (CRM): lead captado -> cliente ativo -> inativo.
enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

/// Tipo de interação registrada na linha do tempo do cliente (CRM).
enum InteractionType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}

/// Situação de uma fatura (financeiro).
enum InvoiceStatus {
  OPEN
  PAID
  CANCELLED
}

/// Meio de pagamento.
enum PaymentMethod {
  CASH
  CARD
  PIX
  TRANSFER
  OTHER
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  name           String
  // E-mail globalmente único: uma conta de login pertence a uma única empresa.
  email          String       @unique
  passwordHash   String
  role           Role         @default(PATIENT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  refreshTokens RefreshToken[]
  doctor        Doctor?
  patient       Patient?

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Doctor {
  id             String       @id @default(uuid()) @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String       @unique @db.Uuid
  specialty      String
  crm            String // registro profissional — único dentro da empresa
  createdAt      DateTime     @default(now())

  availabilities Availability[]
  appointments   Appointment[]

  // CRM/registro é único por empresa (não globalmente — empresas diferentes não conflitam).
  @@unique([organizationId, crm])
  @@index([organizationId])
  @@map("doctors")
}

model Patient {
  id             String       @id @default(uuid()) @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  // Conta de login opcional (autoatendimento). Cadastro na recepção pode não ter user.
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?      @unique @db.Uuid
  name           String
  // PII sensível criptografada a nível de aplicação (ver crypto service). cpfHash p/ lookup.
  // Opcionais: um lead de CRM pode ter só nome + telefone.
  cpfEnc         String?
  cpfHash        String?
  birthDate      DateTime?    @db.Date
  phone          String
  email          String?
  // CRM.
  status         CustomerStatus @default(ACTIVE)
  source         String?
  tags           String[]       @default([])
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  appointments Appointment[]
  interactions CustomerInteraction[]
  invoices     Invoice[]

  // CPF é único por empresa quando presente (múltiplos NULL são permitidos p/ leads).
  @@unique([organizationId, cpfHash])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("patients")
}

/// Linha do tempo de interações com um cliente (CRM): ligações, e-mails, notas...
model CustomerInteraction {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId      String          @db.Uuid
  type           InteractionType @default(NOTE)
  note           String
  authorId       String?         @db.Uuid // usuário (staff) que registrou
  createdAt      DateTime        @default(now())

  @@index([organizationId])
  @@index([patientId, createdAt])
  @@map("customer_interactions")
}

/// Regra de disponibilidade recorrente semanal de um médico.
model Availability {
  id             String       @id @default(uuid()) @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId       String       @db.Uuid
  weekday        Int // 0=domingo ... 6=sábado
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  slotMinutes    Int

  @@index([doctorId, weekday])
  @@index([organizationId])
  @@map("availabilities")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String            @db.Uuid
  doctor         Doctor            @relation(fields: [doctorId], references: [id])
  doctorId       String            @db.Uuid
  patient        Patient           @relation(fields: [patientId], references: [id])
  patientId      String            @db.Uuid
  service        Service?          @relation(fields: [serviceId], references: [id])
  serviceId      String?           @db.Uuid
  startAt        DateTime          @db.Timestamptz(3)
  endAt          DateTime          @db.Timestamptz(3)
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // `during tstzrange` + exclusion constraint adicionados via migration SQL custom (ADR 0002).

  @@index([doctorId, startAt])
  @@index([patientId])
  @@index([organizationId])
  @@index([serviceId])
  @@map("appointments")
}

/// Fatura emitida para um cliente. totalCents é denormalizado (soma dos itens).
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  patient        Patient       @relation(fields: [patientId], references: [id])
  patientId      String        @db.Uuid
  // Vínculo opcional ao agendamento que originou a fatura (scalar, sem relação).
  appointmentId  String?       @db.Uuid
  status         InvoiceStatus @default(OPEN)
  totalCents     Int           @default(0)
  notes          String?
  issuedAt       DateTime      @default(now())
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([organizationId, status])
  @@index([patientId])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String  @db.Uuid
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  serviceId      String? @db.Uuid // referência ao catálogo (scalar, sem relação)

  @@index([invoiceId])
  @@index([organizationId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String        @db.Uuid
  amountCents    Int
  method         PaymentMethod @default(CASH)
  paidAt         DateTime      @default(now())
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([invoiceId])
  @@index([organizationId, paidAt])
  @@map("payments")
}

/// Saída de caixa (despesa) — compõe o fluxo de caixa junto com os recebimentos.
model Expense {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  description    String
  amountCents    Int
  category       String?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId, occurredAt])
  @@map("expenses")
}

/// Trilha de auditoria append-only (LGPD): quem acessou qual recurso e quando.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorId        String?  @db.Uuid
  actorRole      String?
  action         String // ex.: "patient.read", "appointment.create"
  resource       String // ex.: "patient:<uuid>"
  ip             String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([actorId])
  @@index([resource])
  @@index([organizationId])
  @@map("audit_logs")
}
